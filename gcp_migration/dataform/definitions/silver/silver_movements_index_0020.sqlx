config {
  type: "incremental",
  schema: "silver",
  name: "movements",
  uniqueKey: ["source_id", "source_entity_id"],
  tags: ["index_0020", "silver", "movements"]
}

SELECT
  source_id,
  source_entity_id,
  ingest_date,
  ticket_number,
  transport_type,
  departure_date,
  port_from,
  port_to,
  train_number,
  coach_class AS seat_class,
  seat,
  passenger_doc,
  CURRENT_TIMESTAMP() AS created_at
FROM ${ref("stg_index_0020_movements")}
${when(incremental(), `WHERE departure_date >= (SELECT MAX(departure_date) FROM ${self()})`)}
