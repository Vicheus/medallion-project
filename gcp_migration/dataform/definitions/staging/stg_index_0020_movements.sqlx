config {
  type: "view",
  schema: "silver",
  description: "Cleansed and validated staging view for passenger rail tickets and itineraries",
  assertions: {
    uniqueKey: ["source_id", "source_entity_id"],
    nonNull: ["source_id", "source_entity_id", "passenger_name", "departure_date", "port_from", "port_to"],
    rowConditions: [
      "arrival_date >= departure_date"
    ]
  },
  tags: ["index_0020", "staging", "movements"]
}

SELECT
  source_id,
  source_entity_id,
  ingest_date,
  TRIM(CAST(ticket_number AS STRING)) AS ticket_number,
  silver.clean_name(CAST(passenger_name AS STRING)) AS passenger_name,
  silver.parse_date_safe(CAST(birth_date AS STRING)) AS birth_date,
  silver.clean_phone_e164(CAST(phone AS STRING)) AS phone,
  TRIM(CAST(passenger_doc AS STRING)) AS passenger_doc,
  silver.parse_date_safe(CAST(departure_date AS STRING)) AS departure_date,
  silver.parse_date_safe(CAST(arrival_date AS STRING)) AS arrival_date,
  UPPER(TRIM(CAST(port_from AS STRING))) AS port_from,
  UPPER(TRIM(CAST(port_to AS STRING))) AS port_to,
  TRIM(CAST(train AS STRING)) AS train_number,
  COALESCE(UPPER(TRIM(CAST(coach_class AS STRING))), 'UNKNOWN') AS coach_class,
  TRIM(CAST(coach_number AS STRING)) AS coach_number,
  TRIM(CAST(seat AS STRING)) AS seat,
  COALESCE(UPPER(TRIM(CAST(seat_tier AS STRING))), 'STANDARD') AS seat_tier,
  'RAIL' AS transport_type,
  silver.parse_date_safe(CAST(ticket_date AS STRING)) AS ticket_date,
  CURRENT_TIMESTAMP() AS processed_at
FROM ${ref("raw_index_0020")}
WHERE passenger_name IS NOT NULL
  AND departure_date IS NOT NULL
  AND port_from IS NOT NULL
  AND port_to IS NOT NULL
QUALIFY ROW_NUMBER() OVER (PARTITION BY source_id, source_entity_id ORDER BY ingest_timestamp DESC) = 1
