config {
  type: "view",
  schema: "silver",
  description: "Cleansed and validated staging view for passenger rail tickets and itineraries",
  assertions: {
    uniqueKey: ["source_id", "source_entity_id"],
    nonNull: ["source_id", "source_entity_id", "passenger_name", "departure_date", "port_from", "port_to"],
    rowConditions: [
      "arrival_date >= departure_date"
    ]
  },
  tags: ["index_0020", "staging", "movements"]
}

SELECT
  source_id,
  source_entity_id,
  ingest_date,
  TRIM(ticket_number) AS ticket_number,
  silver.clean_name(passenger_name) AS passenger_name,
  silver.parse_date_safe(birth_date) AS birth_date,
  silver.clean_phone_e164(phone) AS phone,
  TRIM(passenger_doc) AS passenger_doc,
  silver.parse_date_safe(departure_date) AS departure_date,
  silver.parse_date_safe(arrival_date) AS arrival_date,
  UPPER(TRIM(port_from)) AS port_from,
  UPPER(TRIM(port_to)) AS port_to,
  TRIM(train) AS train_number,
  COALESCE(UPPER(TRIM(coach_class)), 'UNKNOWN') AS coach_class,
  TRIM(coach_number) AS coach_number,
  TRIM(seat) AS seat,
  COALESCE(UPPER(TRIM(seat_tier)), 'STANDARD') AS seat_tier,
  'RAIL' AS transport_type,
  silver.parse_date_safe(ticket_date) AS ticket_date,
  CURRENT_TIMESTAMP() AS processed_at
FROM ${ref("raw_index_0020")}
WHERE passenger_name IS NOT NULL
  AND departure_date IS NOT NULL
  AND port_from IS NOT NULL
  AND port_to IS NOT NULL
