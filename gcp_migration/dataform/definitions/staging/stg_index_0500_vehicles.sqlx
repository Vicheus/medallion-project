config {
  type: "view",
  schema: "silver",
  description: "Cleansed and validated staging view for traffic police vehicle registrations and owners",
  assertions: {
    uniqueKey: ["source_id", "source_entity_id"],
    nonNull: ["source_id", "source_entity_id", "license_plate", "owner_full_name"],
    rowConditions: [
      "manufacture_year >= 1950"
    ]
  },
  tags: ["index_0500", "staging", "vehicles"]
}

SELECT
  source_id,
  source_entity_id,
  ingest_date,
  UPPER(TRIM(license_plate)) AS license_plate,
  UPPER(TRIM(vin)) AS vin,
  TRIM(model) AS model,
  SAFE_CAST(manufacture_year AS INT64) AS manufacture_year,
  TRIM(color) AS color,
  silver.clean_name(fio) AS owner_full_name,
  silver.parse_date_safe(birth_date) AS owner_birth_date,
  silver.clean_phone_e164(phone) AS owner_phone,
  TRIM(passport) AS owner_passport,
  TRIM(company_name) AS company_name,
  TRIM(company_inn) AS company_inn,
  TRIM(company_ogrn) AS company_ogrn,
  CASE
    WHEN company_inn IS NOT NULL AND company_inn != '' THEN 'CORPORATE'
    ELSE 'INDIVIDUAL'
  END AS ownership_type,
  CURRENT_TIMESTAMP() AS processed_at
FROM ${ref("raw_index_0500")}
WHERE license_plate IS NOT NULL
  AND fio IS NOT NULL
